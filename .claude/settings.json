{
  "mcpServers": {
    "aws-api": {
      "command": "uvx",
      "args": [
        "--from",
        "awslabs.aws-api-mcp-server@latest",
        "awslabs.aws-api-mcp-server.exe"
      ],
      "env": {
        "AWS_REGION": "us-east-1"
      }
    },
    "aws-sns-sqs": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--from",
        "awslabs.amazon-sns-sqs-mcp-server@latest",
        "awslabs.amazon-sns-sqs-mcp-server.exe"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
