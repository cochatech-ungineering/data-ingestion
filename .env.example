EVENT_CHUNK_SIZE=500
PUBLISH_EVENTS=true
ARCHIVE_PUBLISHED_EVENTS=true

AWS_REGION=us-east-1
AWS_PROFILE=cochatech-dev

# scripts/provision_sns_sqs.sh
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:545349726305:cashback-ingestion
SNS_TOPIC_NAME=cashback-ingestion

# scripts/provision_aws_data.sh → infrastructure/aws-data.env
S3_BUCKET=cochatech-data-ingestion-raw-545349726305
DATABASE_URL=postgresql://ingestion:PASSWORD@RDS_HOST:5432/ingestion?sslmode=require
DATABASE_SSL_CA=infrastructure/rds-ca-global.pem
