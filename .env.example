EVENT_CHUNK_SIZE=500
PUBLISH_EVENTS=true
ARCHIVE_PUBLISHED_EVENTS=true
EVENTS_OUTPUT_DIR=events/published

# AWS SNS + SQS — AWS_PROFILE=cochatech-dev ./scripts/provision_sns_sqs.sh
AWS_REGION=us-east-1
AWS_PROFILE=cochatech-dev
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:545349726305:cashback-ingestion
SNS_TOPIC_NAME=cashback-ingestion

DATABASE_URL=postgresql://ingestion:ingestion@localhost:5433/ingestion
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ingestion-raw
MINIO_SECURE=false
